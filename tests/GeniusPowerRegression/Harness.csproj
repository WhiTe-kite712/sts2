<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../MySts2Mod/Sts2PathDiscovery.props" Condition="'$(Sts2DataDir)' == ''" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <_HarnessModAssets>$(MSBuildThisFileDirectory)..\..\MySts2Mod\.godot\mono\temp\obj\project.assets.json</_HarnessModAssets>
    <_HarnessModNuGetData Condition="Exists('$(_HarnessModAssets)')">$([System.IO.File]::ReadAllText('$(_HarnessModAssets)'))</_HarnessModNuGetData>
    <_HarnessBaseLibVersion Condition="'$(_HarnessModNuGetData)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_HarnessModNuGetData), '"Alchyr.Sts2.BaseLib\/([^"]*)').Result('$1'))</_HarnessBaseLibVersion>
    <_HarnessBaseLibVersion Condition="'$(_HarnessBaseLibVersion)' == ''">3.4.7</_HarnessBaseLibVersion>
    <_HarnessPackageRoot Condition="'$(_HarnessModNuGetData)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_HarnessModNuGetData), '"packageFolders"\s*:\s*\{\s*"([^"]+)"').Result('$1'))</_HarnessPackageRoot>
    <_HarnessPackageRoot Condition="'$(_HarnessPackageRoot)' != ''">$([System.Text.RegularExpressions.Regex]::Unescape('$(_HarnessPackageRoot)'))</_HarnessPackageRoot>
    <_HarnessPackageRoot Condition="'$(_HarnessPackageRoot)' == ''">$(NuGetPackageRoot)</_HarnessPackageRoot>
    <_HarnessPackageRoot Condition="'$(_HarnessPackageRoot)' == '' And '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)</_HarnessPackageRoot>
    <_HarnessPackageRoot Condition="'$(_HarnessPackageRoot)' == ''">$(UserProfile)/.nuget/packages/</_HarnessPackageRoot>
    <BaseLibDll Condition="'$(BaseLibDll)' == ''">$(_HarnessPackageRoot)/alchyr.sts2.baselib/$(_HarnessBaseLibVersion)/lib/net9.0/BaseLib.dll</BaseLibDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(Sts2DataDir)\sts2.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2DataDir)\GodotSharp.dll</HintPath></Reference>
    <Reference Include="BaseLib"><HintPath>$(BaseLibDll)</HintPath></Reference>
    <ProjectReference Include="../../MySts2Mod/MySts2Mod.csproj" Condition="'$(ModDll)' == ''" AdditionalProperties="DeployToGame=false" />
    <Reference Include="MySts2Mod" Condition="'$(ModDll)' != ''"><HintPath>$(ModDll)</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Sts2DataDir</_Parameter1><_Parameter2>$(Sts2DataDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- This console harness has no Godot project or mod localization context. -->
  <Target Name="ExcludeModOnlyAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'Godot.SourceGenerators' Or '%(Analyzer.Filename)' == 'Sts2ModAnalyzers'" />
    </ItemGroup>
  </Target>
  <Target Name="CheckReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')" Text="Set Sts2DataDir to the installed game's data_sts2_windows_x86_64 directory." />
    <Error Condition="!Exists('$(BaseLibDll)')" Text="Set BaseLibDll to a compatible BaseLib.dll (tested with 3.4.7)." />
    <Error Condition="'$(ModDll)' != '' And !Exists('$(ModDll)')" Text="ModDll does not exist: $(ModDll)" />
  </Target>
</Project>
