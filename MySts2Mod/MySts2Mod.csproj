<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <AssemblyName>CodeFarmer</AssemblyName>
        <RootNamespace>MySts2Mod</RootNamespace>
        <ModId>CodeFarmer</ModId>
        <ModManifestSource>$(MSBuildProjectDirectory)/$(MSBuildProjectName).json</ModManifestSource>
        <ModDeployDirectory>$(ModsPath)$(ModId)/</ModDeployDirectory>
        <PckPackerSourceDir>$(MSBuildProjectDirectory)/MySts2Mod/</PckPackerSourceDir>
        <PckPackerResPrefix>$(ModId)</PckPackerResPrefix>
        <PckPackerOutputPath>$([System.IO.Path]::Combine('$(OutputPath)', '$(AssemblyName).pck'))</PckPackerOutputPath>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <Publicize>False</Publicize> <!--Allows access to originally private/protected members but may (unlikely to) cause errors.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')" >
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="$(Publicize)">
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.4.7" PrivateAssets="All"/>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.2.1" />
        <!-- Generates a .pck file when building if only using simple assets. May not work on all setups. Uncomment to test. -->
        <PackageReference Include="BSchneppe.StS2.PckPacker" Version="0.1.1" PrivateAssets="All" />
        <AdditionalFiles Include="MySts2Mod/localization/**/*.json"/> <!-- Used by analyzer -->
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="MySts2Mod/**" />
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <EmbeddedResource Remove="MySts2Mod/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
        <None Include=".gitignore" />
        <None Include="MySts2Mod.json" />
        <None Include="project.godot"/>
        <None Include="MySts2Mod/**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="MySts2Mod\images\card_portraits\big\" />
      <Folder Include="MySts2Mod\images\powers\big\" />
      <Folder Include="MySts2Mod\images\relics\big\" />
    </ItemGroup>
    
    <Target Name="CheckDependencyPaths" >
        <Error
                Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
                Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
    </Target>

    <Target Name="UpdateDependencyVersions" BeforeTargets="BeforeBuild" Condition="Exists('.godot/mono/temp/obj/project.assets.json')">
        <PropertyGroup>
            <ManifestPath>$(ModManifestSource)</ManifestPath>
        </PropertyGroup>

        <PropertyGroup>
            <NuGetData>$([System.IO.File]::ReadAllText(".godot/mono/temp/obj/project.assets.json"))</NuGetData>
            <ActiveBaseLibVersion>$([System.Text.RegularExpressions.Regex]::Match($(NuGetData), '"Alchyr.Sts2.BaseLib\/([^"]*)').Result('$1'))</ActiveBaseLibVersion>
            <OldContent>$([System.IO.File]::ReadAllText($(ManifestPath)))</OldContent>
            <NewContent>$([System.Text.RegularExpressions.Regex]::Replace($(OldContent), '("id":\s*"BaseLib",\s*"min_version":\s*")[^"]*', '${1}$(ActiveBaseLibVersion)'))</NewContent>
        </PropertyGroup>

        <WriteLinesToFile
                Condition="'$(OldContent)' != '$(NewContent)'"
                File="$(ManifestPath)"
                Lines="$(NewContent)"
                Overwrite="true"
                Encoding="UTF-8" />

        <Message Condition="'$(OldContent)' != '$(NewContent)'"
                 Text="Updated BaseLib dependency version in mod manifest json to version $(BaseLibVersion)"
                 Importance="high" />
    </Target>
    
    <Target Name="CopyModManifestToOutput" AfterTargets="Build">
        <PropertyGroup>
            <_ManifestSourceText>$([System.IO.File]::ReadAllText('$(ModManifestSource)'))</_ManifestSourceText>
            <_ManifestSourceId>$([System.Text.RegularExpressions.Regex]::Match($(_ManifestSourceText), '&quot;id&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Result('$1'))</_ManifestSourceId>
        </PropertyGroup>
        <Error Condition="'$(_ManifestSourceId)' != '$(ModId)'"
               Text="The manifest id must be $(ModId), matching the DLL and PCK names." />
        <Copy SourceFiles="$(ModManifestSource)"
              DestinationFiles="$(TargetDir)$(ModId).json" />
    </Target>

    <Target Name="DeployCodeFarmerPackage" AfterTargets="PackPck"
            DependsOnTargets="CopyModManifestToOutput"
            Condition="'$(DeployToGame)' != 'false'">
        <Error Condition="'$(PckPackerEnabled)' != 'true' Or !Exists('$(PckPackerSourceDir)') Or '$(PckPackerSkipped)' == 'true' Or !Exists('$(PckPackerOutputPath)')"
               Text="No usable $(ModId).pck was produced; the mod package was not installed." />
        <Message Text="Installing $(ModId) DLL, PCK and manifest to $(ModDeployDirectory)." Importance="high" />
        <Copy SourceFiles="$(TargetPath);$(TargetDir)$(ModId).json;$(PckPackerOutputPath)"
              DestinationFolder="$(ModDeployDirectory)" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModDeployDirectory)"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

        <!-- Keep the previous package, but prevent its manifest from loading the same mod twice. -->
        <PropertyGroup>
            <_LegacyManifest>$(ModsPath)MySts2Mod/MySts2Mod.json</_LegacyManifest>
            <_LegacyManifestText Condition="Exists('$(_LegacyManifest)')">$([System.IO.File]::ReadAllText('$(_LegacyManifest)'))</_LegacyManifestText>
            <_LegacyManifestId Condition="'$(_LegacyManifestText)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_LegacyManifestText), '&quot;id&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Result('$1'))</_LegacyManifestId>
            <_LegacyManifestBackup>$(_LegacyManifest).disabled-$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmssfff'))</_LegacyManifestBackup>
        </PropertyGroup>
        <Move SourceFiles="$(_LegacyManifest)" DestinationFiles="$(_LegacyManifestBackup)"
              Condition="Exists('$(_LegacyManifest)') And ('$(_LegacyManifestId)' == 'MySts2Mod' Or '$(_LegacyManifestId)' == 'CodeFarmer')" />
        <PropertyGroup>
            <_LegacyRenamedManifest>$(ModsPath)MySts2Mod/CodeFarmer.json</_LegacyRenamedManifest>
            <_LegacyRenamedText Condition="Exists('$(_LegacyRenamedManifest)')">$([System.IO.File]::ReadAllText('$(_LegacyRenamedManifest)'))</_LegacyRenamedText>
            <_LegacyRenamedId Condition="'$(_LegacyRenamedText)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_LegacyRenamedText), '&quot;id&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Result('$1'))</_LegacyRenamedId>
            <_LegacyRenamedBackup>$(_LegacyRenamedManifest).disabled-$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmssfff'))</_LegacyRenamedBackup>
        </PropertyGroup>
        <Move SourceFiles="$(_LegacyRenamedManifest)" DestinationFiles="$(_LegacyRenamedBackup)"
              Condition="Exists('$(_LegacyRenamedManifest)') And ('$(_LegacyRenamedId)' == 'MySts2Mod' Or '$(_LegacyRenamedId)' == 'CodeFarmer')" />
    </Target>

    <Target Name="CopyModPackageToPublish" AfterTargets="Publish"
            DependsOnTargets="PackPck;CopyModManifestToOutput">
        <Error Condition="'$(PckPackerEnabled)' != 'true' Or !Exists('$(PckPackerSourceDir)') Or '$(PckPackerSkipped)' == 'true' Or !Exists('$(PckPackerOutputPath)')"
               Text="No usable $(ModId).pck was produced; publish requires a resource pack mounted under res://$(ModId)." />
        <Copy SourceFiles="$(TargetDir)$(ModId).json;$(PckPackerOutputPath)"
              DestinationFolder="$(PublishDir)" />
    </Target>
</Project>
